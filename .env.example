# Public URL of the app (used in sign-in emails, share links, Stripe redirects)
APP_URL=http://localhost:3000

# Database. Omit DATABASE_URL to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/whyus

# Claude API. Enables live crawling + fact extraction for schools without a verified
# corpus, natural-language match explanations, essay angles, interview questions,
# PDF activity parsing, and a fetch fallback for official pages that block bots.
# ANTHROPIC_API_KEY=
# WHYUS_MODEL=claude-opus-5-5

# Email sign-in via Resend. Without a key, sign-in links are printed to the server
# log (development only; production refuses to start sign-in without a provider).
# RESEND_API_KEY=
# EMAIL_FROM="WhyUs <signin@example.com>"

# Stripe payments. Without keys, development builds offer a simulated checkout.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Prices in cents (defaults shown). Counselor plan price/seat count are configurable.
# PRICE_SCHOOL_CENTS=900
# PRICE_UNLIMITED_CENTS=2900
# PRICE_COUNSELOR_CENTS=19900
# COUNSELOR_MAX_STUDENTS=25

# How the research bot identifies itself to school web servers.
# WHYUS_BOT_UA="WhyUsResearchBot/1.0 (+https://example.com/bot)"
